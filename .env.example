# Copy to .env (docker compose reads it) or export these in your shell.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=prozo_compliance
# If MongoDB is not reachable, fall back to an in-memory DB (demo only, data lost on restart)
ALLOW_IN_MEMORY_DB=true
FORCE_IN_MEMORY_DB=false

# --- Files / jobs ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
JOB_WORKERS=2

# --- Optional AI assistant: none | gemini | ollama ---
LLM_PROVIDER=none
# Free key from https://aistudio.google.com/apikey  (never commit a real key)
GEMINI_API_KEY=
# gemini-2.0-flash was shut down by Google on 1 June 2026; use a current model from AI Studio
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Case Study 1: parcel frames -> shipment CSV ---
# The vision agent uses GEMINI_API_KEY above. false = offline mode (OCR + barcode only).
CS1_USE_VISION=true
CS1_VISION_MODEL=gemini-3.5-flash
CS1_VISION_PER_MINUTE=10
CS1_WORKERS=2
CS1_MAX_UPLOAD_MB=500

# --- Case Study 3: daily digest by email (optional) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character app password>, SMTP_FROM=you@gmail.com
# Without SMTP the digests are saved to storage/cs3_outbox/ and shown in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Which manager gets which FC: data/case_study_3/fc_managers.csv (fc,manager,email)
CS3_MANAGERS_FILE=./data/case_study_3/fc_managers.csv
CS3_DEFAULT_MANAGER_EMAIL=
# Send digests automatically every day at this time (HH:MM). Empty = manual only.
CS3_DIGEST_TIME=
